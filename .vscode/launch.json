{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Launch main.py",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["minitest_right_full_shadow"]
    },
    {
      "name": "Python: Eval minitest_right_full",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["task=eval", "exp_name=minitest_right_full", "hand=shadow", "task.debug_viewer=True",
               "task.max_num=-1"]

    },
    {
      "name": "Python: Eval minitest_both_full",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["task=eval", "exp_name=minitest_both_full", "hand=dual_dummy_arm_shadow", "task.debug_viewer=True",
               "task.max_num=-1"]

    },
    {
      "name": "Python: Format learn",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "hand=leap",
        "exp_name=learn_right_full",
        "task=format",
        "task.max_num=100",
        "task.data_name=Learning",
        "task.debug=True",
        "task.data_path=../AnyScaleDexLearn/output/leapMulti_robotMultiHierar_dataset_full_1/tests/step_050000/leapMulti"
      ]
    },
    {
      "name": "Python: Eval learn",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["task=eval", "hand=dual_dummy_arm_leap", "exp_name=learn_both_full", "task.max_num=-1", "task.debug_viewer=True"]

    },
  ]
}
